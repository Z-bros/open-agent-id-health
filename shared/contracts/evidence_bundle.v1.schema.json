{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tb-careos:evidence_bundle:v1",
  "title": "Synthetic administrative evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "observations",
    "exceptions",
    "source_checks",
    "requires_human_approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "source_system",
          "source_record_id",
          "subject_ref",
          "record_type",
          "observed_at"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "source_system": {
            "type": "string"
          },
          "source_record_id": {
            "type": "string"
          },
          "subject_ref": {
            "type": "string"
          },
          "record_type": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "description",
          "evidence_record_ids"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence_record_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_system",
          "attempt",
          "status"
        ],
        "properties": {
          "source_system": {
            "type": "string"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "available",
              "not_found",
              "temporarily_unavailable",
              "permission_denied",
              "error"
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "requires_human_approval": {
      "const": true
    }
  }
}
