# Zetaris getting-started Python UI-proxy helper configuration (read-only tests)
# The URL must point to the Zetaris UI origin, not the raw API endpoint.
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_QUERY_LIMIT=1000
ZETARIS_ENGINE_ID=

# Meterless World Model engine runs locally via the TypeScript reference.
# It does NOT require a generic Meterless API key or endpoint.
