# Default: a self-contained, visibly labelled fixture demonstration.
NEXT_PUBLIC_TBCARE_MODE=demo

# For actual local API reads, set BOTH values, restart Next.js,
# and run the existing Python TB-CareOS server on 127.0.0.1:8765.
# NEVER enable the local proxy on a public Vercel deployment.
# NEXT_PUBLIC_TBCARE_MODE=local
# TBCARE_ENABLE_LOCAL_PROXY=1
